+def test_training_contract_with_real_lightgbm():
+    rng=np.random.default_rng(8)
+    data=pd.DataFrame(rng.normal(size=(100,len(FEATURE_COLUMNS))),columns=FEATURE_COLUMNS)
+    data['outcome']=[0,1]*50
