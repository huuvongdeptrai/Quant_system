   <string>
    QMainWindow { background-color: #0A0C10; color: #E5E7EB; font-family: "Segoe UI", sans-serif; }
    QSplitter::handle { background-color: #1F2328; width: 3px; }
    QSplitter::handle:hover { background-color: #58A6FF; }
    QSplitter::handle:horizontal { width: 3px; }
    QTabWidget#tabWidget::pane { border: none; border-top: 1px solid #1F2328; background: #0A0C10; }
