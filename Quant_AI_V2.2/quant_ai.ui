    QTreeWidget#treeWatchlist::item { border-bottom: 1px solid #1F2328; padding: 3px 2px; }
    QTreeWidget#treeWatchlist::item:hover { background-color: #161B22; }
    QTreeWidget#treeWatchlist::item:selected { background-color: #1F2328; color: #FFFFFF; }
    QTreeWidget#treeWatchlist QHeaderView::section { background-color: #0D1117; color: #6E7681; font-weight: 600; border: none; border-bottom: 1px solid #1F2328; padding: 5px; font-size: 11px; text-transform: uppercase; }
    
    QGroupBox { border: 1px solid #444C56; border-radius: 8px; margin-top: 15px; padding-top: 35px; background-color: #1C2128; }
    QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 10px 20px; color: #58A6FF; font-weight: 800; font-size: 12px; text-transform: uppercase; }
    QLabel.settingLabel { color: #FFFFFF; font-size: 12px; font-weight: bold; margin-bottom: 4px; }
    QComboBox, QDoubleSpinBox, QSpinBox, QLineEdit { background-color: #2D333B; border: 1px solid #535E6C; color: #FFFFFF; padding: 8px 12px; border-radius: 6px; font-size: 13px; font-weight: bold; }
    QComboBox:hover, QDoubleSpinBox:hover, QSpinBox:hover, QLineEdit:hover { border: 1px solid #58A6FF; background-color: #373E47; }
    QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus, QLineEdit:focus { border: 1px solid #58A6FF; background-color: #0D1117; }
    QCheckBox { color: #FFFFFF; font-size: 13px; font-weight: bold; }
    
    QTableWidget { background-color: #0D1117; color: #E5E7EB; border: 1px solid #1F2328; border-radius: 6px; font-family: "Consolas", "Roboto Mono", monospace; font-size: 13px; alternate-background-color: #161B22; selection-background-color: transparent; outline: none; gridline-color: transparent; }
    QTableWidget QWidget { background-color: transparent; }
    QTableWidget::item { padding: 8px 12px; border-bottom: 1px solid #1F2328; }
    QTableWidget::item:hover { background-color: #1F2328; }
    QHeaderView::section { background-color: #010409; color: #8B949E; border: none; border-bottom: 2px solid #30363D; padding: 12px 10px; font-size: 12px; font-weight: bold; text-transform: uppercase; }
    
    QFrame.statCard { background: #0D1117; border: 1px solid #1F2328; border-radius: 6px; }
    QLabel.statTitle { color: #6E7681; font-size: 11px; font-weight: bold; text-transform: uppercase; }
    QLabel.statValue { color: #E5E7EB; font-size: 26px; font-weight: bold; font-family: "Consolas"; }
    QTabWidget#subTabStats::pane { border: none; border-top: 1px solid #1F2328; }
    QTabWidget#subTabStats &gt; QTabBar::tab { background: transparent; color: #8B949E; padding: 10px 15px; font-weight: bold; font-size: 12px; border: none; border-bottom: 2px solid transparent; margin-right: 5px; }
    QTabWidget#subTabStats &gt; QTabBar::tab:selected { color: #58A6FF; border-bottom: 2px solid #58A6FF; }
    QPushButton.btnExport { background-color: transparent; color: #8B949E; border: 1px solid #30363D; padding: 6px 15px; border-radius: 4px; font-weight: bold; }
