+            cls._runtime = runtime
+            cls._emergency_halt = False
+
+    @classmethod
+    def emergency_halt(cls):
+        with cls._lock:
+            cls._emergency_halt = True
+            if cls._runtime:
+                cls._runtime.is_running = False
