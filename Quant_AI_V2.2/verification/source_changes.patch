+def position_history(exits):
+    def get(*args, **kwargs):
+        if "position" not in kwargs:
+            return exits
+        d = next(d for d in exits if d.position_id == kwargs["position"])
+        opening = DummyDeal(d.ticket, 0, 0, -1, 0, magic=d.magic, comment=d.comment)
+        return [opening, d]
+    return get
